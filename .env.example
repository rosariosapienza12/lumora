# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/lumora?schema=public"
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"

# Assistente Zib (facoltativo): senza chiave risponde con la guida di bordo integrata.
ANTHROPIC_API_KEY=
# Free AI for Zib: one of these is enough (Gemini is tried first).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys (models ending in :free)
OPENROUTER_API_KEY=
# Optional: force a provider (gemini, groq, openrouter, anthropic) or a model.
AI_PROVIDER=
AI_MODEL=

# Email (facoltativa): chiave di https://resend.com e mittente con dominio verificato.
# Senza: in sviluppo le email vengono stampate nel terminale; in produzione non partono,
# quindi niente conferma dell'email (e niente pubblicazione) né recupero della password.
RESEND_API_KEY=
MAIL_FROM="Lumora <noreply@tuodominio.it>"

# Contatto mostrato nell'informativa privacy per le richieste sui dati personali (facoltativo).
CONTACT_EMAIL=
