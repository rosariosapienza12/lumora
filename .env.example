# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/lumora?schema=public"
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"

# Assistente Zib (facoltativo): senza chiave risponde con la guida di bordo integrata.
ANTHROPIC_API_KEY=

# Email (obbligatoria in produzione): chiave di https://resend.com e mittente con dominio verificato.
# In sviluppo, senza chiave, le email vengono stampate nel terminale.
RESEND_API_KEY=
MAIL_FROM="Lumora <noreply@tuodominio.it>"
